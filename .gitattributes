# La base ISO se versiona con LF fijo: el manifest de checksums
# (check_kb_blank.py) se calcula sobre LF y debe ser estable en cualquier
# plataforma. Sin esto, un checkout en Windows (CRLF) rompería la guarda.
plugins/sentinel-agents/references/iso-27000/** text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf

# Los workflows .js deben quedar LF (el permission handler rechaza CRLF)
.claude/workflows/*.js text eol=lf
# Sus tests tambien: consistencia con el .js que ejercitan
tests/workflows/*.js text eol=lf

# Bundles multi-harness generados: check_harness.py los compara byte-a-byte
# contra la regeneracion; un checkout CRLF daria falso drift. LF siempre.
dist/** text eol=lf

# Barra (statusline.js + sus tests node) y Panel 4D (.tsx) del plugin fluency-4d: LF fijo,
# para que el hash de status (copia fija vs plugin) y los tests no dependan del checkout.
plugins/fluency-4d/**/*.js text eol=lf
plugins/fluency-4d/**/*.tsx text eol=lf
